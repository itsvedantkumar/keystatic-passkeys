# ---------------------------------------------------------------------------
# The passkey gate
# ---------------------------------------------------------------------------

# Rollout/rollback switch. Unset — or set to anything other than the literal
# string 'passkey' — keeps plain HTTP Basic Auth against KEYSTATIC_AUTH_PASSWORD.
# That default is deliberate: dropping this code into a project changes nothing
# until you opt in. If it defaulted the other way, the deploy that shipped the
# code would 503 /keystatic the moment it landed, before the session secret
# existed in the environment.
#
# Set to 'passkey' only AFTER enrolling at least two devices and setting
# KEYSTATIC_SESSION_SECRET. Rolling back is just unsetting this again — there is
# no data migration either way.
KEYSTATIC_AUTH_MODE=

# Signs the /keystatic session cookie (generate with: openssl rand -hex 32).
# REQUIRED in passkey mode — without it /keystatic returns 503 for everyone,
# which is the intended fail-closed behaviour rather than falling open.
#
# Rotating this value is the session kill switch. Sessions are signed, not
# stored, so there is no per-session revocation; changing this secret
# invalidates every outstanding login at once, on the very next request.
KEYSTATIC_SESSION_SECRET=

# Break-glass password for /keystatic. Passkeys are the normal way in; this is
# the recovery path if every enrolled device is lost. Keep it long and random
# and store it in a password manager — it is not meant to be memorable or typed
# often, and with no Redis configured there is no rate limiting behind it.
#
# NOTE: once ANY passkey is enrolled, this password can still LOG IN but can no
# longer ENROLL a new device. See KEYSTATIC_ENROLL_TOKEN.
KEYSTATIC_AUTH_PASSWORD=

# Recovery token for enrolling a passkey when you cannot already unlock with one
# (generate with: openssl rand -hex 32). Sent as the x-enroll-token header.
#
# This exists because of the step-up rule: once a passkey exists, the password
# alone can NO LONGER add a new credential. Otherwise a leaked password would
# let an attacker mint their own permanent passkey — a foothold that survives
# rotating the password. Set this temporarily if every device is lost, enroll,
# then delete it again.
KEYSTATIC_ENROLL_TOKEN=

# ---------------------------------------------------------------------------
# Identity — must match the domain you actually serve from
# ---------------------------------------------------------------------------

# WebAuthn relying-party id: the bare hostname, no scheme, no port, no slash.
# Drives BOTH the passkey rpID and the Origin allowlist, because they have to
# agree. Defaults to example.com — a domain you do not own — so forgetting to
# set it in production fails closed with a 403 rather than trusting whatever
# Host header arrived.
#
# Changing this orphans every existing passkey: credentials are scoped to the
# rpID that created them.
KEYSTATIC_RP_ID=

# Human-readable name shown in the OS passkey prompt ("Sign in to ___").
# Cosmetic. Defaults to KEYSTATIC_RP_ID.
KEYSTATIC_RP_NAME=

# Label for the single admin identity in the OS passkey list. Cosmetic.
KEYSTATIC_ADMIN_LABEL=

# ---------------------------------------------------------------------------
# Upstash Redis — OPTIONAL, but passkeys do not work without it
# ---------------------------------------------------------------------------

# Credential and challenge storage, plus every rate limiter. Set BOTH or
# NEITHER; a half-configured pair throws at startup rather than silently
# booting with rate limiting disabled.
#
# Without these the app still runs and the break-glass password still works,
# but: no passkeys can be enrolled or used (the WebAuthn routes return 503),
# and NOTHING is rate limited — including password attempts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Security alert email — OPTIONAL, degrades to console logging
# ---------------------------------------------------------------------------

# Alerts fire on: a passkey enrolled, a passkey removed, the break-glass
# password used. All three must be set or alerts are written to the process log
# instead. A log nobody reads will not tell you an attacker enrolled a passkey
# at 3am — configure these before trusting this in production.
RESEND_API_KEY=
KEYSTATIC_ALERT_EMAIL=
KEYSTATIC_ALERT_FROM=

# ---------------------------------------------------------------------------
# Keystatic itself — only needed for GitHub storage mode (i.e. production)
# ---------------------------------------------------------------------------

# In development, storage is `local` and none of this is needed.
# Create a GitHub OAuth App at https://github.com/settings/developers and set
# the callback URL to https://your-domain.example/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Signs Keystatic's own session tokens (generate with: openssl rand -hex 32).
# Separate from KEYSTATIC_SESSION_SECRET, which signs the passkey gate cookie.
KEYSTATIC_SECRET=

# Which repo Keystatic commits content to in production.
KEYSTATIC_GITHUB_REPO_OWNER=
KEYSTATIC_GITHUB_REPO_NAME=
